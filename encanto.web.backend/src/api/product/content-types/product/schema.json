{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "minLength": 5,
      "required": true
    },
    "inStock": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "blocks"
    },
    "price": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "stock": {
      "type": "integer"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "product"
    },
    "sku": {
      "type": "uid"
    },
    "tag": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "capacity": {
      "type": "string"
    },
    "availableSpots": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "priceNote": {
      "type": "string",
      "default": "Desde $price por persona"
    },
    "order": {
      "type": "integer",
      "required": true,
      "unique": true
    }
  }
}
